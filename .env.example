# Copy to .env.local for local work. In Vercel, set the same names under Project Settings, Environment Variables.
# NEXT_PUBLIC_ values are built into the page, so nothing secret goes in them. Never commit a filled-in copy.

# the shared Supabase project (the same one the current dashboard signs in to)
NEXT_PUBLIC_SUPABASE_URL=https://lesyptuwllcgajdxzjje.supabase.co
# the project's public anon key (Supabase, Project Settings, API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# where pages that are not ported yet still live
NEXT_PUBLIC_LEGACY_DASHBOARD_URL=https://aiparagon.vercel.app/dashboard

# only accounts at this domain can use the dashboard
NEXT_PUBLIC_TEAM_EMAIL_DOMAIN=aiparagonconsulting.com

# n8n's webhooks, called from server code only (optional: this is the default). Not secret, and never sent to the page.
N8N_WEBHOOK_URL=https://n8n.aiparagonconsulting.com/webhook
